        function addNewBook() {
            const title = document.getElementById('new-book-title').value.trim();
            const cat = document.getElementById('new-book-cat').value;
            const price = parseFloat(document.getElementById('new-book-price').value);
            const oldPrice = parseFloat(document.getElementById('new-book-oldprice').value || price);
            const icon = document.getElementById('new-book-icon').value.trim();
            const desc = document.getElementById('new-book-desc').value.trim();

            if (!title || isNaN(price) || !desc) {
                triggerCustomAlert("Fadlan buuxi dhammaan meelaha muhiimka ah ee buugga!");
                return;
            }

            const newId = booksList.length > 0 ? booksList[booksList.length - 1].id + 1 : 101;
            booksList.push({
                id: newId,
                title: title,
                price: price,
                oldPrice: oldPrice,
                desc: cat + " - " + desc,
                category: cat,
                icon: icon
            });

            triggerCustomAlert("Buugga si guul leh ayaa loogu daray dukaanka!");
            updateDashboardCounters();
            renderAdminItemsList(); 
            if (currentBookFilter === cat) renderBooks();
            
            document.getElementById('new-book-title').value = '';
            document.getElementById('new-book-price').value = '';
            document.getElementById('new-book-oldprice').value = '';
            document.getElementById('new-book-desc').value = '';
        }

        function addNewDataPackage() {
            const mainServiceId = document.getElementById('new-data-service').value;
            const title = document.getElementById('new-data-title').value.trim();
            const price = parseFloat(document.getElementById('new-data-price').value);
            const oldPrice = parseFloat(document.getElementById('new-data-oldprice').value || price);
            const badge = document.getElementById('new-data-badge').value.trim() || "Xirmo";
            const infoRaw = document.getElementById('new-data-info').value.trim();

            if (!title || isNaN(price) || !infoRaw) {
                triggerCustomAlert("Fadlan buuxi dhammaan meelaha muhiimka ah ee Xirmada Datada!");
                return;
            }

            const infoArray = infoRaw.split(',').map(item => item.trim());
            const serviceObj = mainServices.find(s => s.id === mainServiceId);
            const color = serviceObj ? serviceObj.color : "#00965e";

            const newId = subPackages.length > 0 ? subPackages[subPackages.length - 1].id + 1 : 1;
            subPackages.push({
                id: newId,
                mainServiceId: mainServiceId,
                title: title,
                price: price,
                oldPrice: oldPrice,
                info: infoArray,
                badge: badge,
                color: color
            });

            triggerCustomAlert("Xirmada Datada si guul leh ayaa loogu daray!");
